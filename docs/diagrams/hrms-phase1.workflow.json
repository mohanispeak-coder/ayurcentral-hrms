  "cards": [
    {
      "dot": "emerald",
      "title": "Leave Contract",
      "items": [
        "Server checks overlap, balance, and self-approval",
        "SUBMITTED waits for manager review or HR override"
      ]
    },
    {
      "dot": "rose",
      "title": "Payroll Immutability",
      "items": [
        "LOP hints lop_days only on an open run",
        "LOCKED is immutable; correction is a new run"
      ]
    },
    {
      "dot": "cyan",
      "title": "Notification Events",
      "items": [
        "Leave submit, approve, and reject go through MailApp",
        "UNDER_REVIEW, APPROVED, and PAYSLIP_AVAILABLE after calculate"
      ]
    }
  ]
