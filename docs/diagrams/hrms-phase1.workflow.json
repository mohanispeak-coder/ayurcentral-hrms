    { "id": "inputs-calculate", "from": "inputs", "to": "calculate" },
    { "id": "calculate-lock", "from": "calculate", "to": "lock", "label": "APPROVED → LOCKED", "variant": "emphasis" },
    { "id": "lock-notify", "from": "lock", "to": "notify", "label": "PAYSLIP_AVAILABLE", "variant": "emphasis" },
    { "id": "decide-reject", "from": "decide", "to": "reject", "label": "REJECTED", "variant": "security", "role": "error" },
    { "id": "lock-correction", "from": "lock", "to": "correction", "label": "new run only", "variant": "security", "role": "branch" }
