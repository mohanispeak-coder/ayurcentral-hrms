{
  "name": "ayurcentral-hrms",
  "private": true,
  "description": "AyurCentral HRMS — contract tests (Node) and browser QA (Playwright)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test tests/browser/mobile.spec.js",
    "test:e2e:headed": "playwright test --headed --workers=1",
    "test:e2e:debug": "playwright test tests/browser/mobile.spec.js --project=chromium-390 --headed --workers=1",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:auth": "node tests/browser/run-codegen.js",
    "test:e2e:auth:save": "node tests/browser/save-auth-manual.js",
    "test:e2e:check-storage": "node tests/browser/check-storage.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0"
  },
  "engines": {
    "node": ">=18"
  }
}
